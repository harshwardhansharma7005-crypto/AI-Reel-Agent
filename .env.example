# Copy this file to ".env" and fill in values. NEVER commit .env.

# ---- AI provider (only the one chosen in settings.yaml -> ai.provider is needed) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Instagram Graph API (Professional account) ----
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---- Cloud storage (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2...) ----
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Leave empty for AWS S3. For R2: https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=

# ---- Optional overrides ----
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# REEL_VIDEO_DIR=
# REEL_MUSIC_DIR=
# REEL_USERNAME=@har.*shhh
