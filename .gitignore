# Secrets
.env
*.pem

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Media folders: allow individual assets, except the oversized video
media/videos/*
!media/videos/.gitkeep
!media/videos/*.mp4
media/videos/open ai.mp4

media/music/*
!media/music/.gitkeep
!media/music/*.mp3
!media/music/*.mpeg
!media/music/*.wav
!media/music/*.m4a

# Runtime data
media_demo/
data/*.db
data/*.db-journal
data/cache/
data/analysis_cache/

# Generated output and logs
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep

# Other media formats
*.mov
*.mkv

# Keep human-readable history
!history/*.csv

# Local backup files
*.bak
settings.yaml.backup
